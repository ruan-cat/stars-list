{
	"files.eol": "\n",
	"files.exclude": {
		"**/node_modules": true,
		"**/.git": true,
		"**/dist": true,
		"**/dist-ssr": true,
		"**/build": true,
		"**/.next": true,
		"**/.nuxt": true,
		"**/.output": true,
		"**/.vite": true,
		"**/.vitepress/dist": true,
		"**/.vitepress/cache": true,
		"**/.vuepress/dist": true,
		"**/.vuepress/cache": true,
		"**/.turbo": true,
		"**/.vercel": true,
		"**/.cache": true,
		"**/.temp": true,
		"**/.tmp": true,
		"**/coverage": true,
		"**/.nyc_output": true,
		"**/.vitest-reporter-html": true,
		"**/.eslintcache": true,
		"**/.stylelintcache": true,
		"**/*.tsbuildinfo": true,
		"**/*.map": true,
		"**/logs": true,
		"**/*.log": true
	},
	"files.associations": {
		".cursorignore": "ignore"
	},
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"AGENTS.md": "CLAUDE.md,GEMINI.md,DESIGN.md"
	},
	"terminal.integrated.cwd": "${workspaceFolder}",
	"terminal.integrated.splitCwd": "workspaceRoot",
	"search.exclude": {
		"**/dist": true,
		"**/.cache": true,
		"**/.temp": true,
		"**/.vercel": true,
		"**/.turbo": true,
		"**/cache": true,
		"**/.vitepress/cache/**": true,
		"**/.nuxt/**": true,
		"**/node_modules": true,
		"**/.git": true,
		"**/dist-ssr": true,
		"**/build": true,
		"**/.next": true,
		"**/.nuxt": true,
		"**/.output": true,
		"**/.vite": true,
		"**/.vitepress/dist": true,
		"**/.vitepress/cache": true,
		"**/.vuepress/dist": true,
		"**/.vuepress/cache": true,
		"**/.tmp": true,
		"**/coverage": true,
		"**/.nyc_output": true,
		"**/.vitest-reporter-html": true,
		"**/.eslintcache": true,
		"**/.stylelintcache": true,
		"**/*.tsbuildinfo": true,
		"**/*.map": true,
		"**/logs": true,
		"**/*.log": true
	},
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/.turbo/**": true,
		"**/node_modules/*/**": true,
		"**/dist/**": true,
		"**/.changeset/**": true,
		"**/.git/**": true,
		"**/node_modules/**": true,
		"**/.vercel/**": true,
		"**/dist-ssr/**": true,
		"**/build/**": true,
		"**/.next/**": true,
		"**/.nuxt/**": true,
		"**/.output/**": true,
		"**/.vite/**": true,
		"**/.vitepress/dist/**": true,
		"**/.vitepress/cache/**": true,
		"**/.vuepress/dist/**": true,
		"**/.vuepress/cache/**": true,
		"**/.cache/**": true,
		"**/.temp/**": true,
		"**/.tmp/**": true,
		"**/cache/**": true,
		"**/coverage/**": true,
		"**/.nyc_output/**": true,
		"**/.vitest-reporter-html/**": true,
		"**/.eslintcache": true,
		"**/.stylelintcache": true,
		"**/*.tsbuildinfo": true,
		"**/*.map": true,
		"**/logs/**": true,
		"**/*.log": true
	},
	"search.indexing.maxFileSize": 1048576,
	"typescript.tsserver.maxTsServerMemory": 4096,
	"typescript.disableAutomaticTypeAcquisition": true,
	"typescript.tsserver.watchOptions": {
		"watchFile": "useFsEvents",
		"watchDirectory": "useFsEvents",
		"fallbackPolling": "dynamicPriority"
	},
	"typescript.tsdk": "node_modules/typescript/lib",
	"code-runner.executorMap": {
		"typescript": "pnpm dotenvx run -- tsx $fullFileName"
	},
	"vue.server.includeLanguages": ["vue"],
	"iconify.annotations": true,
	"iconify.inplace": true
}
