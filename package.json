{
	"name": "@ruan-cat-docs/stars-list",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.14.0"
	},
	"author": {
		"name": "ruan-cat",
		"email": "1219043956@qq.com",
		"url": "https://github.com/ruan-cat"
	},
	"description": "阮喵喵的github star列表，是一个基于工作流自动更新的文档项目。",
	"homepage": "https://ruan-cat.github.io/stars-list",
	"main": "index.js",
	"scripts": {
		"git:fetch": "git fetch -p",
		"git:dev-2-main": "git rebase dev main && git push --follow-tags",
		"git:main-2-dev": "git rebase main dev",
		"up-taze": "pnpm up @ruan-cat/taze-config -L && npx taze -r",
		"format": "prettier --experimental-cli --write --no-parallel '**/*.{js,jsx,ts,tsx,mts,json,css,scss,md,yml,yaml,html}'",
		"prepare": "simple-git-hooks",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docs:build-in-github-page": "vitepress build docs --base=/stars-list/",
		"build": "pnpm docs:build-in-github-page",
		"todo:scan": "tsx scripts/get-todo/cli.ts",
		"todo:validate": "tsx scripts/get-todo/validate.ts",
		"todo:test": "tsx --test scripts/get-todo/*.test.ts"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.1.4",
		"@ruan-cat/commitlint-config": "^4.11.1",
		"@ruan-cat/taze-config": "^1.1.1",
		"@ruan-cat/vitepress-preset-config": "^3.2.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/query-persist-client-core": "^5.102.5",
		"@tanstack/query-sync-storage-persister": "^5.102.5",
		"@tanstack/vue-query": "^5.102.5",
		"@types/node": "^26.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"commitizen": "^4.3.1",
		"commitlint": "^20.5.0",
		"cz-git": "^1.12.0",
		"lint-staged": "^16.4.0",
		"lucide-vue-next": "^1.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-lint-md": "1.0.1",
		"reka-ui": "^2.10.4",
		"simple-git-hooks": "^2.13.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"taze": "^19.11.0",
		"tsx": "^4.23.12",
		"vite": "5.4.21",
		"vitepress": "^1.6.4",
		"vitepress-demo-plugin": "^1.5.1",
		"vue": "^3.5.32"
	},
	"keywords": [
		"ruan-cat",
		"github",
		"stars",
		"list"
	],
	"license": "MIT",
	"dependencies": {
		"@iconify-icons/mdi": "^2.0.0",
		"@iconify-icons/vscode-icons": "^2.0.2",
		"@iconify/vue": "^5.0.1",
		"@lucide/vue": "^1.38.0",
		"@vueuse/core": "^14.4.0",
		"citty": "^0.2.2",
		"consola": "^3.4.2",
		"degit": "^3.8.0",
		"ofetch": "^1.5.1"
	}
}
