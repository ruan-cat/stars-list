{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["docs/.vitepress/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["**/*.test.ts"]
}
