{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,

		// === 2026-09-05 优化：tsserver 内存降级（PLAN v2 Task D Batch 2） ===
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",

		"types": ["node"],
		"baseUrl": ".",
		"paths": { "@/*": ["docs/.vitepress/theme/*"] }
	},
	"include": ["docs/.vitepress/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["**/*.test.ts"]
}
